# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string -> "URI", use the pooled "Transaction" connection for DATABASE_URL and the direct connection for DIRECT_URL if you split them; for a simple MVP a single pooled URL is fine)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (for goat photos and document uploads)
# In production on Vercel: Storage tab -> Create Database -> Blob -> connect
# to this project, and Vercel injects this automatically, no action needed.
# For local development, copy the token from that same Blob store's
# ".env.local" tab in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

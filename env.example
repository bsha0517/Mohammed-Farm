# PostgreSQL connection string (Supabase).
#
# CRITICAL: must be the "Transaction" mode pooler (port 6543), NOT the
# "Session" mode pooler and NOT the direct connection. Session mode has a
# small connection pool that gets exhausted almost immediately under
# Vercel's serverless functions (each invocation can open its own
# connection) — this causes: "FATAL: max clients reached in session mode".
#
# Get it from: Supabase dashboard -> Project Settings -> Database ->
# Connection pooling -> Mode: "Transaction" -> copy the URI (port 6543).
# Then append ?pgbouncer=true&connection_limit=1 as shown below —
# connection_limit=1 is what actually keeps each function instance from
# hogging multiple connections and refilling the pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (for goat photos and document uploads)
# In production on Vercel: Storage tab -> Create Database -> Blob -> connect
# to this project, and Vercel injects this automatically, no action needed.
# For local development, copy the token from that same Blob store's
# ".env.local" tab in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
